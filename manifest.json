{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "1.4.0",
  "description": "__MSG_description__",
  "minimum_chrome_version": "121",
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "favicon"
  ],
  "commands": {
    "open-switcher": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "__MSG_cmdOpen__"
    },
    "toggle-last": {
      "suggested_key": {
        "default": "Alt+W"
      },
      "description": "__MSG_cmdToggle__"
    },
    "tab-left": {
      "suggested_key": {
        "default": "Alt+Left"
      },
      "description": "__MSG_cmdLeft__"
    },
    "tab-right": {
      "suggested_key": {
        "default": "Alt+Right"
      },
      "description": "__MSG_cmdRight__"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "_favicon/*"
      ],
      "matches": [
        "<all_urls>"
      ],
      "extension_ids": [
        "*"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ui.js",
        "overlay.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "default_locale": "en"
}
